# ==============================================================================
# Personal AI Job Search and Matching Application - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. USAJOBS Official API Credentials
# Register for an API key at: https://developer.usajobs.gov/
# ------------------------------------------------------------------------------
# Your USAJOBS Authorization Key
USAJOBS_API_KEY=api_key_here

# Your registered email or application identifier (required by USAJOBS User-Agent header)
USAJOBS_USER_AGENT=email_or_app_identifier_here

# ------------------------------------------------------------------------------
# 2. O*NET Web Services Credentials
# Register at: https://services.onetcenter.org/
# ------------------------------------------------------------------------------
# O*NET API Key (sent via X-API-Key header)
ONET_API_KEY=your_onet_api_key_here

# (Optional: legacy O*NET username and password if using Basic Auth)
ONET_USERNAME=
ONET_PASSWORD=

# ------------------------------------------------------------------------------
# 3. Application & Vector Store Configuration
# ------------------------------------------------------------------------------
APP_ENV=development
DATA_DIR=data
VECTOR_DB_DIR=data/vector_db
UPLOADS_DIR=data/uploads
EMBEDDING_MODEL=all-MiniLM-L6-v2
